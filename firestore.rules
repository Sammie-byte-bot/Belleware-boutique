rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the requester is an admin
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Each user can read/write their own profile. Admins can read/write all users.
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Orders: only admins can read all orders. Creators can create orders for themselves.
    match /orders/{orderId} {
      allow read: if isAdmin();
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if isAdmin();
    }

    // Products: admins manage products
    match /products/{productId} {
      allow read, write: if isAdmin();
    }

    // Notifications: authenticated users can read and create notifications.
    // Updates are allowed only when they modify allowed fields (per-user read flags or resolve flags).
    match /notifications/{notificationId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.title is string
                    && request.resource.data.msg is string;
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(resource.data.keys().union(['readBy','updatedAt','resolved','resolvedAt']));
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
