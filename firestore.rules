rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function isAdmin() {
      return signedIn() && (
        ('admin' in request.auth.token && request.auth.token.admin == true)
        || (
          exists(userPath(request.auth.uid))
          && get(userPath(request.auth.uid)).data.get('role', '') == 'admin'
        )
      );
    }

    function isDeliveredOrder(orderId, uid) {
      let order = get(/databases/$(database)/documents/orders/$(orderId)).data;
      return order.userId == uid && order.status == 'DELIVERED';
    }

    function validDeliveryFee(d) {
      return d.paymentMethod == 'pickup'
        ? d.deliveryFee == 0
        : (
            d.customerInfo.deliveryAreaId is string
            && d.customerInfo.deliveryAreaId.size() > 0
            && exists(/databases/$(database)/documents/deliveryAreas/$(d.customerInfo.deliveryAreaId))
            && get(/databases/$(database)/documents/deliveryAreas/$(d.customerInfo.deliveryAreaId)).data.name
                 == d.customerInfo.deliveryArea
            && get(/databases/$(database)/documents/deliveryAreas/$(d.customerInfo.deliveryAreaId)).data.fee
                 == d.deliveryFee
            && get(/databases/$(database)/documents/deliveryAreas/$(d.customerInfo.deliveryAreaId)).data.active
                 == true
          );
    }

    function validDeliveryArea(data) {
      return data.keys().hasOnly([
               'name', 'fee', 'active', 'createdAt', 'updatedAt'
             ])
        && data.keys().hasAll(['name', 'fee', 'active'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.fee is int
        && data.fee >= 0
        && data.active is bool;
    }

    function validOrderCreate() {
      let d = request.resource.data;
      return signedIn()
        && d.keys().hasOnly([
             'orderId', 'userId', 'items', 'subtotal', 'deliveryFee', 'total',
             'customerInfo', 'paymentMethod', 'paymentReference', 'status', 'createdAt'
           ])
        && d.keys().hasAll([
             'userId', 'items', 'subtotal', 'deliveryFee', 'total',
             'customerInfo', 'paymentMethod', 'status', 'createdAt'
           ])
        && d.userId == request.auth.uid
        && d.paymentMethod in ['card', 'mpesa', 'pickup']
        && d.status == (d.paymentMethod == 'pickup' ? 'PLACED_UNPAID' : 'PLACED')
        && (
             d.paymentMethod == 'pickup'
               ? d.paymentReference == null
               : d.paymentReference is string
           )
        && d.items is list && d.items.size() > 0 && d.items.size() <= 50
        && d.subtotal is number && d.subtotal >= 0
        && d.deliveryFee is number && d.deliveryFee >= 0
        && d.total == d.subtotal + d.deliveryFee
        && d.customerInfo.keys().hasOnly(
             ['fullName', 'email', 'phone', 'address', 'deliveryArea', 'deliveryAreaId'])
        && d.customerInfo.keys().hasAll(
             ['fullName', 'email', 'phone', 'address', 'deliveryArea', 'deliveryAreaId'])
        && d.createdAt == request.time
        && validDeliveryFee(d);
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && !('role' in request.resource.data);

      allow read: if signedIn() && request.auth.uid == userId;

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.get('role', null) == resource.data.get('role', null);

      allow read, create, update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /productStats/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read, write: if isAdmin();
    }

    match /deliveryAreas/{areaId} {
      allow read: if signedIn();
      allow create: if isAdmin() && validDeliveryArea(request.resource.data);
      allow update: if isAdmin() && validDeliveryArea(request.resource.data);
      allow delete: if isAdmin();
    }

    match /deliverySettings/{docId} {
      allow read: if signedIn();

      allow create, update: if isAdmin()
        && request.resource.data.areas is list
        && request.resource.data.areas.size() <= 50;

      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if validOrderCreate();

      allow read: if signedIn() && request.auth.uid == resource.data.userId;

      allow update: if signedIn()
        && request.auth.uid == resource.data.userId
        && resource.data.status in ['PLACED', 'PLACED_UNPAID', 'CONFIRMED']
        && request.resource.data.diff(resource.data).changedKeys()
             .hasOnly(['status', 'cancelReason', 'canceledAt'])
        && request.resource.data.status == 'CANCELLED';

      allow read, update, delete: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow read: if signedIn() && request.auth.uid == resource.data.userId;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
             'userId', 'type', 'title', 'body', 'orderId',
             'read', 'createdAt', 'products'
           ])
        && (request.auth.uid == request.resource.data.userId || isAdmin());

      allow update: if signedIn()
        && request.auth.uid == resource.data.userId
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['read']);
    }

    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if signedIn()
        && request.auth.uid == request.resource.data.userId
        && isDeliveredOrder(request.resource.data.orderId, request.auth.uid);

      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
