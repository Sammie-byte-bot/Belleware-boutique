# Non-secret M-Pesa settings. Copy this file to functions/.env before deploying.
# (The 4 secrets - consumer key/secret, passkey, callback token - are NOT stored here;
#  set them with `firebase functions:secrets:set`, see MPESA_SETUP.md.)

# "production" for live money (your Daraja "Prod-BELLEWEAR BOUTIQUE" app)
# "sandbox" while testing with the Daraja sandbox app
MPESA_ENV=production

# Short code shown on your Daraja app card
MPESA_SHORTCODE=1444988

# CustomerPayBillOnline  -> the short code is a PAYBILL
# CustomerBuyGoodsOnline -> the short code is a TILL number
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# Only for Till numbers whose Till differs from the Store/HO number. Usually leave blank.
MPESA_PARTY_B=

# Leave blank to use https://us-central1-<your-project>.cloudfunctions.net/paymentCallback
MPESA_CALLBACK_BASE_URL=
